{
  "rewrites": [
    {
      "source": "/dbs/:path*",
      "destination": "https://dbs.roapp.page/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/roapp/send-order-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/roapp/send-lead-followups",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/roapp/send-lead-invitations",
      "schedule": "*/10 * * * *"
    }
  ]
}
