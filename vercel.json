{
  "rewrites": [
    {
      "source": "/dbs/:path*",
      "destination": "https://dbs.roapp.page/:path*"
    }
  ],

  "headers": [
    {
      "source": "/dbs/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],

  "crons": [
    {
      "path": "/api/roapp/send-order-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/roapp/send-lead-followups",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/roapp/send-lead-invitations",
      "schedule": "*/10 * * * *"
    }
  ]
}
